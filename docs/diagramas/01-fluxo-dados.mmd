    classDef private fill:#FFF0E3,stroke:#C85C12,color:#593016;
    classDef model fill:#EEF6EC,stroke:#447A35,color:#24421D;
    class PUB,EXT,PAIR,BEL public;
    class PRIV,KNOW private;
    class MODEL,NLI model;
